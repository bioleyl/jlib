{
  "name": "@syware/jlib",
  "version": "0.2.0",
  "description": "A tree-shakeable component library on Jadis and native Web Components, organised in atomic design",
  "keywords": [
    "web-components",
    "custom-elements",
    "jadis",
    "components",
    "design-system",
    "ui",
    "atomic-design",
    "tree-shakeable"
  ],
  "type": "module",
  "license": "MIT",
  "author": "SyWare",
  "homepage": "https://bioleyl.github.io/jlib/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bioleyl/jlib.git"
  },
  "bugs": {
    "url": "https://github.com/bioleyl/jlib/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js"
    },
    "./atoms/*": {
      "types": "./dist/atoms/*.d.ts",
      "import": "./dist/atoms/*.js"
    },
    "./molecules/*": {
      "types": "./dist/molecules/*.d.ts",
      "import": "./dist/molecules/*.js"
    },
    "./organisms/*": {
      "types": "./dist/organisms/*.d.ts",
      "import": "./dist/organisms/*.js"
    },
    "./templates/*": {
      "types": "./dist/templates/*.d.ts",
      "import": "./dist/templates/*.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/all.js",
    "./dist/*.css",
    "./src/all.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "npm run build:lib && npm run size:report && npm run build:site",
    "build:lib": "node scripts/build-lib.mjs",
    "build:site": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts",
    "generate": "node scripts/generate-index.mjs",
    "size": "npm run build:lib && npm run size:report",
    "size:report": "node scripts/size-report.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:site && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run generate -- --check && npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@jadis/core": "^1.3.0"
  },
  "dependencies": {
    "lucide": "^1.61.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@jadis/core": "^1.3.0",
    "@types/node": "^24.13.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
